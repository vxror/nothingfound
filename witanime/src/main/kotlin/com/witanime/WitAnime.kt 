    // 🚀 UPGRADE: Enhanced Yonaplay to catch direct MP4/M3U8, not just GDrive
    private suspend fun decodeYonaplayAndLoad(yonaplayUrl: String, subtitleCallback: (SubtitleFile) -> Unit, callback: (ExtractorLink) -> Unit) {
        try {
            val html = app.get(yonaplayUrl, referer = mainUrl, headers = defaultHeaders).text
            val regex = Regex("""go_to_player\('([A-Za-z0-9+/=]+)'\)""")
            val matches = regex.findAll(html).map { it.groupValues[1] }.toList()
            if (matches.isEmpty()) return

            for (encoded in matches) {
                var fixed = encoded
                val padding = encoded.length % 4
                if (padding != 0) fixed += "=".repeat(4 - padding)
                try {
                    val decoded = String(Base64.decode(fixed, Base64.DEFAULT))
                    
                    // 1. Check GDrive
                    if (decoded.contains("drive.google.com/file/d/")) {
                        val match = Regex("""/file/d/([0-9A-Za-z_-]{10,})""").find(decoded)
                        val fileId = match?.groupValues?.get(1)
                        if (fileId != null) {
                            val directUrl = "https://drive.usercontent.google.com/download?id=$fileId&export=download&confirm=t"
                            callback(newExtractorLink("Yonaplay", "Google Drive", directUrl, ExtractorLinkType.VIDEO) {
                                referer = "https://drive.google.com/"; this.quality = Qualities.Unknown.value
                            })
                            continue
                        }
                    }
                    
                    // 2. 🆕 Check Direct MP4/M3U8
                    val directMatch = Regex("""(https?://[^\s"'<>]+\.(?:mp4|m3u8)[^\s"'<>]*)""").find(decoded)
                    if (directMatch != null) {
                        val url = directMatch.groupValues[1]
                        val type = if (url.contains(".m3u8")) ExtractorLinkType.M3U8 else ExtractorLinkType.VIDEO
                        callback(newExtractorLink("Yonaplay", "Direct", url, type) {
                            referer = yonaplayUrl; this.quality = Qualities.Unknown.value
                        })
                        continue
                    }

                    // 3. Fallback to core
                    loadExtractor(decoded, subtitleCallback, callback)
                } catch (e: Exception) {}
            }
        } catch (e: Exception) {}
    }
